@using UmbracoCMS.ViewModels
@model QuestionFormViewModel

@using (Html.BeginUmbracoForm("HandleQuestionForm", "Form", FormMethod.Post, new { novalidate = "novalidate", id = "questionForm" }))
{
    <div class="flex flex-col gap-6">

        <div class="flex flex-row gap-4 w-full">
            <div class="w-full">
                <label asp-for="Name" class="sr-only"></label>
                <input asp-for="Name" type="text" placeholder="@Html.DisplayNameFor(x => x.Name)" class="w-full p-3 italic border border-gray-300 rounded-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                <span asp-validation-for="Name"></span>
            </div>

            <div class="w-full">
                <label asp-for="Email" class="sr-only"></label>
                <input asp-for="Email" type="text" placeholder="@Html.DisplayNameFor(x => x.Email)" class="w-full p-3 italic border border-gray-300 rounded-sm focus:ring-2 focus:ring-primary focus:outline-none" />
                <span asp-validation-for="Email"></span>
            </div>
        </div>

        <div>
            <label asp-for="Question" class="sr-only"></label>
            <textarea asp-for="Question" placeholder="@Html.DisplayNameFor(x => x.Question)" class="w-full p-3 pr-10 border border-gray-300 rounded-sm focus:ring-2 focus:ring-primary focus:outline-none"></textarea>
            <span asp-validation-for="Question"></span>
        </div>

        <div class="pb-[2.5rem]">
            <button type="submit" class="bg-primary text-white py-3 px-10 no-underline rounded cursor-pointer font-bold">Submit</button>
        </div>

    </div>
}
