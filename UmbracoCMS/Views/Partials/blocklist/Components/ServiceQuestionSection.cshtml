@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using UmbracoCMS.ViewModels
@{
    var content = (ContentModels.ServiceQuestionSection)Model.Content;

    var formViewModel = new QuestionFormViewModel
    {
    };
}

<section class="pt-10">

    <div class="max-w-7xl mx-auto px-4 flex gap-4">

        <div class="mx-auto flex w-full flex-col justify-center bg-neutral px-6 py-14">


            <div class="flex py-[2rem]">

                <h2 class="mt-2 text-3xl font-bold sm:text-4xl text-body-text w-[45%]">@content.ServiceQuestionTitle</h2>

            </div>

            <partial name="Partials/Forms/_QuestionForm" model="formViewModel" />

            @if (TempData["QuestionFormSuccess"] != null)
            {
                <div class="bg-green-50 text-green-700 p-4 mx-[2rem] mb-4 rounded-md">
                    @TempData["QuestionFormSuccess"]
                </div>
            }
            else if (TempData["QuestionFormError"] != null)
            {
                <div class="bg-red-50 text-red-700 p-4 mx-[2rem] mb-4 rounded-md">
                    @TempData["QuestionFormError"]
                </div>
            }


        </div>

    </div>

</section>