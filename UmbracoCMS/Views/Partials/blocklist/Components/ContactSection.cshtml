@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using UmbracoCMS.ViewModels
@{
    var content = (ContentModels.ContactSection)Model.Content;
    var callbackSettings = Model.Settings as ContentModels.ContactSettings;

    var bgImage = content?.ContactBgImage?.Url() ?? "~/images/Risk-Management";
    
    var formViewModel = new CallbackFormViewModel
    {
        Options = callbackSettings?.ContactCallbackRequestOptions ?? []
    };
}

<section class="relative">

    <div class="h-[90%] w-full bg-center bg-no-repeat bg-cover absolute -z-10" style="background-image: url('@bgImage');">
    </div>


    <div class="mx-auto max-w-6xl pt-[18.5rem]">

        <div class="mx-auto flex w-full flex-col justify-center bg-neutral px-6 py-14 shadow-[0px_0px_34px_1px_rgba(0,0,0,0.21)]">


            <div class="flex flex-col items-center text-center">
                <span class="text-xs font-semibold text-secondary">@content?.ContactLabel</span>
                <h2 class="mt-2 text-3xl font-bold sm:text-4xl text-body-text w-[45%]">@content?.ContactTitle</h2>
                <p class="my-8 text-xs text-body-text text-center italic w-[45%]">
                    @content?.ContactText
                </p>
            </div>

            <partial name="Partials/Forms/_ContactForm" model="formViewModel" />
            
            <!-- formulär -->


        </div>
    </div>
    
</section>