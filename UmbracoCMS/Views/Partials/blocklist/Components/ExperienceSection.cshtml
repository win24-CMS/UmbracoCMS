@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var content = (ContentModels.ExperienceSection)Model.Content;
}

<section class="py-[5rem]">
    <div class="max-w-7xl mx-auto px-4">
        <div class="flex flex-row gap-[4rem] justify-center">
            <div class="flex flex-col gap-1 w-3/12">
                @if (content.ExperienceSectionImage != null)
                {
                    <img src="@content.ExperienceSectionImage.Url()" class="w-full h-full object-cover" />
                }
                <p class="text-xs text-body-text italic">@content.ExperienceSectionRole</p>
            </div>
            <div class="w-8/12 flex flex-col">
                <div class="rte">@Html.Raw(content.ExperienceSectionBody)</div>
            </div>
        </div>
    </div>
</section>