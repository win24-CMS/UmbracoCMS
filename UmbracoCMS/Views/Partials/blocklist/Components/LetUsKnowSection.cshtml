@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var content = (ContentModels.LetUsKnowSection)Model.Content;
    var settings = Model.Settings as ContentModels.LetUsKnowSettings;

    var sectionColor = settings?.LetUsKnowBgColor?.Label.ToLower() ?? "#ffffff";

    var rootContent = Umbraco.ContentAtRoot();
    var siteSetting = rootContent.OfType<SiteSettings>().FirstOrDefault();
}

<section class="pt-18 bg-@sectionColor">
    <div class="max-w-7xl mx-auto px-4 flex gap-4">
        <div class="w-7/12">
            @if (content.LetUsKnowImage != null)
            {
                <img src="@content.LetUsKnowImage.Url()" class="w-full h-full object-fill" />
            }
        </div>
        <div class="w-5/12 self-center flex flex-col gap-6">
            <h1 class="text-primary text-[3rem] font-bold mb-4 leading-14">@content?.LetUsKnowTitle</h1>
            <div class="flex flex-col gap-6">
                <div class="flex gap-2">
                    <i class="fa-solid fa-location-dot text-secondary !text-[1.5rem]"></i>
                    <div class="flex flex-col">
                        <p class="text-body-text font-semibold">Office location</p>
                        <p class="text-body-text">@siteSetting?.ContactAddress</p>
                    </div>
                </div>
                <div class="flex gap-2">
                    <i class="fa-solid fa-phone text-secondary !text-[1.5rem]"></i>
                    <div class="flex flex-col">
                        <p class="text-body-text font-semibold">Phone number</p>
                        <p class="text-body-text italic">@siteSetting?.ContactPhone</p>
                    </div>
                </div>
                <div class="flex gap-2">
                    <i class="fa-regular fa-envelope text-secondary !text-[1.5rem]"></i>
                    <div class="flex flex-col">
                        <p class="text-body-text font-semibold">E-mail address</p>
                        <p class="text-body-text italic">@siteSetting?.ContactEmail</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>